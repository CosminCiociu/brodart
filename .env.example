# cPanel credentials are separate from SFTP. Never use the HTTP panel URL to send a password.
CPANEL_URL=http://81.196.152.62:2082
CPANEL_USERNAME=brodartr
CPANEL_PASSWORD=

# Get the SFTP host, remote path, and SSH host-key fingerprint from the hosting provider.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=brodartr
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
SFTP_HOST_KEY_SHA256=

# Explicit FTPS deployment for the confirmed staging WordPress installation.
# Keep certificate validation enabled; use the hostname covered by the TLS certificate.
FTPS_HOST=server1.webteamconcept.com
FTPS_PORT=21
FTPS_USERNAME=
FTPS_PASSWORD=
FTPS_REMOTE_PATH=/wp
# Set this exact value only after confirming /wp is staging and making a remote backup.
FTPS_STAGING_CONFIRM=
